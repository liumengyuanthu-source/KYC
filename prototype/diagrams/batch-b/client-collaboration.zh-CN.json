  "lanes": [
    {
      "id": "request",
      "label": "员工审阅"
    },
    {
      "id": "contributor",
      "label": "有限贡献者"
    },
    {
      "id": "review",
      "label": "用途评估"
    },
    {
      "id": "case",
      "label": "同一案件"
    }
  ],
  "nodes": [
    {
      "id": "requirements",
      "lane": "request",
      "col": 0,
      "type": "external",
      "label": "要求 / 缺口",
      "sublabel": "主体及用途",
      "width": 180
    },
    {
      "id": "request-items",
      "lane": "request",
      "col": 1,
      "type": "external",
      "label": "请求 · 两个项目",
      "sublabel": "先审阅，再模拟派发",
      "width": 180
    },
    {
      "id": "grant",
      "lane": "contributor",
      "col": 1,
      "type": "external",
      "label": "Person T · 有限访问",
      "sublabel": "认证与访问范围独立",
      "width": 180
    },
    {
      "id": "submission",
      "lane": "contributor",
      "col": 2,
