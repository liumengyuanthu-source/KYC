  "edges": [
    {
      "from": "requirements",
      "to": "request-items"
    },
    {
      "from": "request-items",
      "to": "grant",
      "label": "已审阅范围"
    },
    {
      "from": "grant",
      "to": "submission",
      "label": "仅分配项目"
    },
    {
      "from": "submission",
      "to": "intake"
    },
    {
      "from": "intake",
      "to": "assessment",
      "label": "已释放及关联"
    },
    {
      "from": "assessment",
      "to": "case-state",
      "label": "仅本项进展"
    }
  ],
  "cards": [
    {
      "dot": "slate",
      "title": "访问不等于业务权限",
      "items": [
        "Reference 用于定位；模拟认证用于识别。",
        "Grant 仅开放已分配项目，而非整个案件。"
      ]
    },
    {
      "dot": "slate",
      "title": "局部进展",
      "items": [
        "EV-A05 仅可能支持代表 Entity A 协调资料。",
        "签约、交易及整体准入保持独立。"
      ]
    }
  ]
