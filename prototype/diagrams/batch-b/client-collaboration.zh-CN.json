    },
    {
      "id": "assessment",
      "lane": "review",
      "col": 3,
      "type": "external",
      "label": "协调资料用途",
      "sublabel": "Ops 记录用途评估",
      "width": 180
    },
    {
      "id": "case-state",
      "lane": "case",
      "col": 3,
      "type": "external",
      "label": "案件 · 尚未就绪",
      "sublabel": "保留其他未决条件",
      "width": 180
