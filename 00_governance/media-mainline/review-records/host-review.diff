tton>${i===0?`<div class="subscenes">${button(T(byId('SCN-ENTITY').title),'scene','SCN-ENTITY','',`data-scene="SCN-ENTITY"`)}</div>`:i===1?`<div class="subscenes">${['SCN-SOURCE','SCN-GAP','SCN-VALIDATE'].map(x=>button(T(byId(x).title),'scene',x,'',`data-scene="${x}"`)).join('')}</div>`:i===2?`<div class="subscenes">${button(L('Population','筛查群体'),'scene','SCN-POPULATION')}${button(L('EDD · conditional','EDD · 条件分支'),'scene','SCN-EDD')}</div>`:''}</div><div class="journey-cell">${L(['Clarify review applicability.','Resolve complex requirements.','Human judgment on ambiguity.','Review sufficiency and conditions.','Inspect decision and authority.'][i],['明确专业审查适用性。','处理复杂要求。','人工判断模糊事项。','复核充分性与条件。','检查决定及权限依据。'][i])}</div><div class="journey-cell">${i===0?button(L('Conflicts may start from intake','利益冲突可从受理早启'),'scene','SCN-CONFLICTS','ghost'):i===3?`<div class="controls">${button(L('Legal','法务'),'scene','SCN-LEGAL')}${button(L('Credit','信贷'),'scene','SCN-CREDIT')}</div>`:L(['','Proceed when own inputs allow.','Independent branch work continues.','','Provide branch-specific outcomes.'][i],['','自身输入具备时开展工作。','继续独立分支工作。','','提交各分支专属结果。'][i])}</div></section>`}).join('')}</div></div></div>`}<div class="matrix-caption"><span>${L('Five reading stages, not a sequential approval waterfall.','五个阅读阶段，并非串行审批瀑布。')} · <span id="camera-status">${n.stage}</span></span><div class="controls">${button('←','pan','-1','',`aria-label="${L('Previous stage','上一阶段')}"`)}${button('→','pan','1','',`aria-label="${L('Next stage','下一阶段')}"`)}${button(L('Overview','总览'),'zoom','overview')}${button(L('Read','阅读'),'zoom','read')}${button(n.zoom==='focus'?L('Exit focus','退出聚焦'):L('Focus stage','聚焦阶段'),'zoom',n.zoom==='focus'?'read':'focus')}</div></div>`;}
+function studio(){return `<main id="main"><section class="intro"><div><p class="eyebrow">${L('01 / JOURNEY & SCENARIOS','01 / 旅程与场景')}</p><h1>${L('One case.<br>A shared view of readiness.','一个案件。<br>共同看清准入条件。')}</h1><p class="intro-copy">${L('Follow the work from requirements to a human screening decision. Then see what still stands between local progress and clear-to-trade.','从适用要求走到人工筛查决定，再看清：完成局部工作后，距离整体交易准入还缺什么。')}</p></div><div class="method"><span class="eyebrow">${L('THE WORKSHOP METHOD','WORKSHOP 方法')}</span><div class="method-line"><span>${L('Process','流程')}</span><b>→</b><span>${L('Journey','旅程')}</span><b>→</b><span>${L('Work & decisions','工作与决定')}</span><b>→</b><span>${L('Product validation','产品验证')}</span></div><p class="small muted" style="margin:18px 0 0">${L('Project sources establish the activities. Proposed design and synthetic records make the proposition testable.','项目材料支撑业务活动；拟议设计与合成记录让方案可以被实际检验。')}</p></div></section>${caseStrip()}<section><div class="section-head"><h2><span class="section-count">02</span>${L('The institutional journey','机构业务旅程')}</h2><div class="controls">${comparison()}${modeControls()}</div></div><div class="contextbar"><label>${L('Trigger','触发')}<select id="trigger">${[['new-relationship','New relationship','新机构关系'],['product-extension','Product extension · not authored','产品扩展 · 尚未编制'],['material-change','Material change · not authored','重大变化 · 尚未编制']].map(([v,en,zh])=>`<option value="${v}" ${n.trigger===v?'selected':''}>${L(en,zh)}</option>`).join('')}</select></label><label>${L('Viewpoint','视角')}<select id="role">${[...roles,['ROLE-CASEMGR','Case Manager','案件经理']].map(([v,en,zh])=>`<option value="${v}" ${n.role===v?'selected':''}>${L(en,zh)}</option>`).join('')}</select></label><span class="location">${n.comparison==='current'?'Current':'Target'} / ${n.stage} / ${esc(n.scenario)}</span></div>${n.trigger!=='new-relationship'?`<div class="notice">${L('This trigger is not authored in Round A. The synthetic case remains a ne