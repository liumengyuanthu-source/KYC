+ const scene=()=>{const i=Math.min(n.batchBeats?.[n.scenario]?.beat||0,beats.length-1),beat=beats[i],old=n.originScopeRevision;return `<section class="batch-context"><span class="eyebrow">S1 / ${n.scenario} · ${B('Scope','范围')} v${sc.revision}</span>${old&&old!==sc.revision?`<p class="notice">${B('Scope changed during work','工作期间范围已变更')}: v${old} → v${sc.revision}. ${B('Same case and source scene restored; latest session retained.','已恢复同一案件及来源场景，保留最新会话。')}</p>`:''}${mediaSlot(n.scenario,n.locale)}${benchmarks()}${figure(n.scenario==='SCN-SCOPE'?'DG-SCOPE-A':'DG-ENTITY-A')}<details class="batch-focus" open><summary>${B('Live session · latest saved business records','实际会话 · 最新已保存业务记录')}</summary>${n.scenario==='SCN-SCOPE'?dl([[B('Actual session scope','实际会话范围'),label(sc.scope_status)+' / v'+sc.revision],[B('Proposed counterparty','拟交易主体'),sc.counterparty_entity_id?'Entity A':B('Awaiting clarification','等待澄清')],[B('Requested product','申请产品'),'FX forward'],[B('Booking / eligibility','Booking / 资格'),B('Unknown / not assessed','未知 / 尚未评估')]]):authority()}</details><details><summary>${B('What can continue / what waits','哪些可继续 / 哪些需等待')}</summary>${gates()}${figure('DG-ENABLE-A')}</details><div class="batch-next"><strong>${B('Journey connection','旅程衔接')}</strong><p>${n.scenario==='SCN-SCOPE'?B('Scope outputs feed entity / authority review, then a requirements draft.','范围输出进入主体 / 代表权限复核，继而供要求草稿使用。'):B('Entity and authority outputs feed SCN-REQUIREMENTS. Unresolved authority stays attached; downstream work is not completed by continuing.','主体与权限输出进入 SCN-REQUIREMENTS。未解决权限随上下文保留；继续主线不会完成下游工作。')}</p>${button(B('Open next linked scene','打开下一关联场景'),'scene',n.scenario==='SCN-SCOPE'?'SCN-ENTITY':'SCN-REQUIREMENTS')}</div></section>`;};
+ const print=()=>`<section class="print-scene batch-print"><h2>D2 Batch A · ${B('Scope, parties and authority','范围、主体与权限')}</h2><p>DEMO-CTT-001 · SRC-013 Final v1.0 · SRC-014 Media Brief v1.0 · ${B('Scope','范围')} v${sc.revision} · ${B('Synthetic / reported / source reviewed / unknown are distinct','合成 / 声称 / 来源复核 / 未知为不同状态')}</p>${dl([[B('Request','请求'),'EV-A01 / FX forward / USD procurement'],[B('Group display','集团展示'),'Group A'],[B('Counterparty','交易主体'),sc.counterparty_entity_id?'Entity A':B('Unresolved','尚未明确')],[B('Booking / eligibility / DD','Booking / 资格 / 尽调等级'),B('Not provided / not assessed','尚未提供 / 尚未评估')],[B('Scope','范围'),label(sc.scope_status)]])}${parties()}${authority()}${taskList()}${['DG-SCOPE-A','DG-ENTITY-A','DG-ENABLE-A'].map(figure).join('')}${staticMediaStory('SCN-SCOPE',n.locale)}${staticMediaStory('SCN-ENTITY',n.locale)}</section>`;
+ return {panel,scene,print,gates,label};
+}
+let helpController;
+export function bindBatchHelp(){
+ helpController?.abort();helpController=new AbortController();
+ const root=document.querySelector('#scenario-dialog[open]')||document.querySelector('#app');
+ const trigger=root?.querySelector('.batch-help'),popover=root?.querySelector('#authority-help');if(!trigger||!popover)return;
+ let suppressed=false;const show=()=>{if(!suppressed&&!popover.matches(':popover-open')){popover.showPopover();trigger.setAttribute('aria-expanded','true');}};
+ trigger.addEventListener('mouseenter',()=>{suppressed=false;show();});trigger.addEventListener('focus',e=>{if(popover.contains(e.relatedTarget))return;suppressed=false;show();});
+ popover.addEventListener('toggle',()=>trigger.setAttribute('aria-expanded',String(popover.matches(':popover-open'))));
+ document.addEventListener('keydown',function dismiss(e){if(e.key==='Escape'&&popover.matches(':popover-open')){suppressed=true;popover.hidePopover();e.preventDefault();e.stopImmediatePropagation();}}, {capture:true,signal:helpController.signal});
+}

